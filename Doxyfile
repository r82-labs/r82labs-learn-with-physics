PROJECT_NAME           = "Slingshot Physics Library"
OUTPUT_DIRECTORY       = docs
INPUT                  = src
RECURSIVE              = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
SHOW_NAMESPACES        = YES
GENERATE_LATEX         = NO

# Modern UI Settings
GENERATE_TREEVIEW      = YES
HTML_EXTRA_STYLESHEET  = docs/theme/doxygen-awesome.css
HTML_COLORSTYLE        = LIGHT

# MathJax for Physics formulas
USE_MATHJAX            = YES
MATHJAX_VERSION        = MATHJAX_3
MATHJAX_RELPATH        = https://cdn.jsdelivr.net/npm/mathjax@3

# C++ Logic Fixes
BUILTIN_STL_SUPPORT    = YES
OPTIMIZE_OUTPUT_FOR_C  = NO
HIDE_UNDOC_MEMBERS     = NO

# Fix for Namespace Members list
# This forces classes/structs to be grouped under namespace members
TYPEDEF_HIDES_STRUCT   = NO
EXTRACT_LOCAL_CLASSES  = YES

# Ensure symbols are linked properly
SOURCE_BROWSER         = YES
